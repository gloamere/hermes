[Unit]
Description=Daily server summary to the Hermes owner
After=network-online.target mihomo.service netdata.service
OnFailure=hermes-alert@%n.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/hermes-ops/monitor.py report
TimeoutStartSec=150
Nice=10
UMask=0077
Restart=on-failure
RestartSec=15min
